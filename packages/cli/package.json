{
  "name": "@aiusage/cli",
  "version": "1.7.0",
  "description": "Track and sync AI tool token usage across devices.",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/0verme/aiusage.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/0verme/aiusage",
  "bugs": {
    "url": "https://github.com/0verme/aiusage/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "bin": {
    "aiusage": "dist/cli.js"
  },
  "keywords": [
    "aiusage",
    "claude-code",
    "codex",
    "tokens",
    "cli",
    "analytics"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && node build.mjs",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aiusage/shared": "workspace:*",
    "@types/node": "^22",
    "esbuild": "^0.27.4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
